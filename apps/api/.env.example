APP_ENV=development
DEBUG=true
# Required outside development; exact origin, no trailing slash or wildcard.
# FRONTEND_ORIGIN=https://dashboard.example.com
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/DBNAME

ZERODHA_API_KEY=
ZERODHA_API_SECRET=
ZERODHA_REDIRECT_URL=http://127.0.0.1:8000/integrations/zerodha/callback
TOKEN_ENCRYPTION_KEY=

# Optional server-controlled post-login destination (local default in development).
# DASHBOARD_URL=http://127.0.0.1:5173/

# Railway production: APP_ENV=production, DEBUG=false.
# DATABASE_URL may also use postgresql:// or postgres:// (driver normalized to psycopg).
# Preserve provider-required sslmode/sslrootcert options; never disable TLS to fix errors.
# ZERODHA_REDIRECT_URL=https://api.example.com/integrations/zerodha/callback
# DASHBOARD_URL=https://dashboard.example.com/
# Uvicorn reads this directly: ONLY verified ingress proxy IPs/CIDRs.
# FORWARDED_ALLOW_IPS=<trusted-proxy-ip-or-cidr>
# Railway supplies PORT; do not hard-code it.
